"""Student Attendance Cleaner - cleans attendance.txt into attendance_clean.csv."""
import csv

INPUT_FILE = "attendance.txt"
OUTPUT_FILE = "attendance_clean.csv"


def main():
    try:
        with open(INPUT_FILE, encoding="utf-8") as f:
            lines = f.readlines()
    except FileNotFoundError:
        print(f"Error: '{INPUT_FILE}' not found. Place it in the same folder.")
        return

    # List comprehension: strip spaces, fix capitalization, skip blank lines
    cleaned = [" ".join(line.strip().title().split()) for line in lines if line.strip()]

    unique_students = set(cleaned)          # set removes duplicates
    final_list = sorted(unique_students)    # alphabetical order

    with open(OUTPUT_FILE, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["name"])
        writer.writerows([name] for name in final_list)

    print(f"Original records : {len(cleaned)}")
    print(f"Unique students  : {len(unique_students)}")
    print("\nCleaned attendance list:")
    for i, name in enumerate(final_list, 1):
        print(f"  {i}. {name}")
    print(f"\nSaved to {OUTPUT_FILE}")


if __name__ == "__main__":
    main() 